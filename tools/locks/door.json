{
  "permissions": {
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "exec python3 -I \"$(dirname \"$(readlink -f \"$(command -v jl)\")\")/tools/locks/bash_gate.py\""
          }
        ]
      }
    ]
  }
}
